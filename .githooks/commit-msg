#!/bin/sh

# Git이 넘겨준 커밋 메시지 파일에서 첫 줄만 검사합니다.
commit_msg_file=$1
commit_msg=$(sed -n '1p' "$commit_msg_file")

# 예: feat: 좋아요 엔티티 추가
if printf '%s\n' "$commit_msg" |
  grep -Eq '^(feat|fix|style|refactor|test|chore|build|front): .+$'; then
  exit 0
fi

cat <<EOF
커밋 메시지 규칙에 맞지 않습니다: $commit_msg

허용되는 형식:
  prefix: 한줄요약

prefix 종류:
  | fix      | 기능을 수정
  | feat     | 기능을 추가
  | style    | 기능, 로직 수정 없이 코드 포맷(들여쓰기, 세미콜론 등) 등을 수정
  | refactor | 기능은 동일, 대신 구조가 바뀜, 코틀린 마이그레이션 등에 해당
  | test     | 테스트 코드 추가 및 수정시 사용
  | build    | 의존성 업데이트, 배포할 때 사용
  | front    | 프론트 추가, 수정, 삭제
  | chore    | hooks 설정, README 수정 등 위의 유형에 해당하지 않는 것들
EOF

exit 1
