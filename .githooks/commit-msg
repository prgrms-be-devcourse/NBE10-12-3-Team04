#!/bin/sh

# Git이 넘겨준 커밋 메시지 파일에서 첫 줄만 검사합니다.
commit_msg_file=$1
commit_msg=$(sed -n '1p' "$commit_msg_file")

# 예: feat: 좋아요 엔티티 추가
if printf '%s\n' "$commit_msg" |
  grep -Eq '^(feat|fix|docs|style|refactor|test|chore|build|ci|perf|revert): .+$'; then
  exit 0
fi

cat <<EOF
커밋 메시지 규칙에 맞지 않습니다: $commit_msg

허용되는 형식:
  label: 한줄요약

예시:
  feat: 좋아요 엔티티 추가
  fix: 로그인 유효성 검사 오류 수정
  docs: API 문서 업데이트
  build: Gradle 의존성 선언 방식 정리
  chore: 브랜치 네이밍 컨벤션 정리
EOF

exit 1
