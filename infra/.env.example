# MySQL
# MYSQL_DATABASE와 SPRING_DATASOURCE_URL의 데이터베이스 이름은 같아야 합니다.
# MySQL 계정과 권한은 mysql-data-local 볼륨을 처음 만들 때만 초기화됩니다.
# 값을 바꾼 뒤에는 개발 데이터 삭제에 동의한 경우에만 `docker compose ... down -v`로 볼륨을 재생성하세요.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=triptrace
MYSQL_USER=triptrace
MYSQL_PASSWORD=change-me-password

# Backend datasource
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/triptrace

# Backend security / CORS
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Backend upload / logs
LOG_DIR=/app/logs
IMAGE_UPLOAD=/images
SERVING_UPLOAD_PATH=/images/serving
THUMBNAIL_UPLOAD_PATH=/images/thumbnail
PROFILE_UPLOAD_PATH=/images/profile
PUBLIC_PREFIX=/

# Backend limits / tokens
IMAGE_FILE_SIZE=10MB
MAX_IMAGE_FILES_SIZE=100MB
ACCESS_TOKEN_EXPIRATION_SECONDS=18000
REFRESH_TOKEN_EXPIRATION_SECONDS=604800
THUMBNAIL_WIDTH=1024
THUMBNAIL_HEIGHT=1024

# External APIs
GOOGLE_MAPS_API_KEY=your_google_maps_server_key

# Frontend
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_VERSION=0.0.1-SNAPSHOT

# Image versions
BACKEND_VERSION=0.0.1-SNAPSHOT
FRONTEND_VERSION=0.0.1-SNAPSHOT

# Caddy
# SITE_ADDR은 Caddyfile의 사이트 주소다. 운영에서는 실제 도메인을 사용한다.
SITE_ADDR=localhost
# 외부 host 포트만 환경별로 바꾼다. Caddy 컨테이너 내부 포트는 80/443으로 고정한다.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Compose 내부 서비스 주소. backend/frontend 서비스명을 유지하면 기본값으로 충분하다.
BACKEND_UPSTREAM=backend:8080
FRONTEND_UPSTREAM=frontend:3000

# Local monitoring
PROMETHEUS_HOST_PORT=9090
